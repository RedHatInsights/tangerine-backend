{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "7 days",
  "extends": [
    ":disableMajorUpdates",
    "helpers:pinGitHubActionDigests",
    "helpers:disableTypesNodeMajor",
    "github>konflux-ci/mintmaker-presets:cve-automerge-all"
  ],
  "pipenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group python dependencies",
      "matchManagers": [ "pipenv" ],
      "matchDepTypes": [ "devDependencies" ],
      "matchUpdateTypes": [ "minor", "patch", "digest" ],
      "groupName": "pipenv dependencies"
    },
    {
      "description": "Group container image updates",
      "matchManagers": [ "dockerfile" ],
      "matchUpdateTypes": [ "digest", "patch", "pinDigest" ],
      "groupName": "container images"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [ "github-actions" ],
      "matchUpdateTypes": [ "digest", "minor", "patch", "pinDigest" ],
      "groupName": "GitHub Actions"
    }
  ]
}
